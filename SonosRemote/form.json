{
    "elements": [
        {
            "type": "Label",
            "caption": "Tile for the tile visualization: device selection, power, one group via Master switch, favorites and the Sonos library."
        },
        {
            "type": "List",
            "name": "Devices",
            "caption": "Devices",
            "rowCount": 8,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Instance (Sonos player or other device)",
                    "name": "InstanceID",
                    "width": "260px",
                    "add": 0,
                    "edit": {
                        "type": "SelectInstance"
                    }
                },
                {
                    "caption": "Name (optional)",
                    "name": "Name",
                    "width": "160px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Power switch (e.g. Z2M plug)",
                    "name": "PowerVariable",
                    "width": "240px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Volume (optional)",
                    "name": "VolumeVariable",
                    "width": "180px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Mute (optional)",
                    "name": "MuteVariable",
                    "width": "180px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Playback (optional, other devices)",
                    "name": "StatusVariable",
                    "width": "200px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Title (optional, other devices)",
                    "name": "TitleVariable",
                    "width": "200px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Input for group (optional, other devices)",
                    "name": "SourceVariable",
                    "width": "220px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Input value",
                    "name": "SourceValue",
                    "width": "120px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Sonos players come from the Sonos module (tkugelberg/Sonos). Leave the power switch empty for devices that are always on."
        },
        {
            "type": "Label",
            "caption": "Group: select the devices with the switch „Group“ in the tile, then switch on „Master“. Sonos devices play in sync. Other devices are coupled: they are switched on, set to the input above and follow play/pause/stop of the master."
        },
        {
            "type": "NumberSpinner",
            "name": "BrowseLimit",
            "caption": "Library entries per request",
            "minimum": 10,
            "maximum": 500
        },
        {
            "type": "SelectColor",
            "name": "AccentColor",
            "caption": "Accent color"
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Add all Sonos players",
            "onClick": "IPS_RequestAction($id, 'importSonos', '{}');"
        },
        {
            "type": "Button",
            "caption": "Refresh tile",
            "onClick": "IPS_RequestAction($id, 'refresh', '{}');"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Music services (search in the tile)",
            "items": [
                {
                    "type": "Label",
                    "caption": "Link the music services you want to search in the tile (e.g. Qobuz, Amazon Music). The service must also be set up in the Sonos app. Radio via TuneIn works without linking. ★ = used in your Sonos favorites, ✓ = linked."
                },
                {
                    "type": "Select",
                    "name": "LinkService",
                    "caption": "Music service",
                    "width": "420px",
                    "value": 0,
                    "options": [
                        { "caption": "-", "value": 0 }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Load services from Sonos",
                            "onClick": "IPS_RequestAction($id, 'loadServices', '{}');"
                        },
                        {
                            "type": "Button",
                            "caption": "Link service",
                            "onClick": "IPS_RequestAction($id, 'linkStart', $LinkService);"
                        },
                        {
                            "type": "Button",
                            "caption": "Remove link",
                            "onClick": "IPS_RequestAction($id, 'unlink', $LinkService);"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "name": "LinkInfo",
                    "caption": ""
                },
                {
                    "type": "ValidationTextBox",
                    "name": "LinkUrl",
                    "caption": "Login page",
                    "width": "700px",
                    "visible": false
                },
                {
                    "type": "Button",
                    "name": "LinkOpen",
                    "caption": "Open login page",
                    "link": true,
                    "visible": false,
                    "onClick": "echo SNR_GetLinkUrl($id);"
                },
                {
                    "type": "List",
                    "name": "LinkedServices",
                    "caption": "Linked services",
                    "rowCount": 4,
                    "columns": [
                        { "caption": "Service", "name": "Name", "width": "auto" },
                        { "caption": "Login", "name": "Auth", "width": "120px" },
                        { "caption": "Sonos account", "name": "Account", "width": "130px" }
                    ],
                    "values": []
                }
            ]
        }
    ]
}
